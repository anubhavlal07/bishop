# Bishop runs offline by default. Every value below is optional; with none of
# them set, `just demo` and `just eval` work against the deterministic mock
# model, the committed corpus and the committed ATT&CK catalogue.

# ── model provider ──────────────────────────────────────────────────────────
# Unset (or "mock") is the default and makes no network calls.
# Set to "anthropic" for a live run. Bishop refuses to start a live provider
# without a key rather than silently falling back to the mock, because a
# scorecard that quietly changed provider would be meaningless.
# BISHOP_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BISHOP_MODEL_ID=claude-opus-5
# BISHOP_MODEL_EFFORT=high

# ── storage ─────────────────────────────────────────────────────────────────
# Absent means in-memory: incidents and the audit chain live for the process.
# Point this at Postgres to persist them.
# DATABASE_URL=postgresql://bishop:bishop@localhost:5432/bishop

# ── console ─────────────────────────────────────────────────────────────────
# Where the console looks for the API.
# NEXT_PUBLIC_BISHOP_API=http://localhost:8000

# ── threat intelligence ─────────────────────────────────────────────────────
# Bishop reads reputation from a cache, never from a live feed at triage time.
# `just intel` populates the cache; these keys are only needed for that.
# abuse.ch requires a free account for the ThreatFox and URLhaus APIs.
# ABUSECH_AUTH_KEY=
# NVD_API_KEY=
