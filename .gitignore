# ─── Local authoring scaffolding — never published ───────────────────────────
# Bishop's public repo ships the system and its docs, not the tooling used to
# build it. Everything below stays on this machine.
CLAUDE.md
PLAN.md
.claude/
.cursor/
.aider*
AGENTS.md
.github/copilot-instructions.md
scratch/
notes/

# ─── Secrets ─────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Data: fetched by script, never committed ────────────────────────────────
data/
outbox/
storage/
eval/results/*.json
!eval/results/baseline.json
# Every held-out run is committed, dated, and never overwritten. A held-out
# result that can be quietly re-run and replaced is not a held-out result.
!eval/results/holdout-*.json

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# ─── Node / Next.js ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

